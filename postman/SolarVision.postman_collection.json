    {
      "name": "Dashboard",
      "item": [
        {
          "name": "Métricas (potência média)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/dashboard/metrics?granularidade=dia",
              "host": ["{{baseUrl}}"],
              "path": ["api", "dashboard", "metrics"],
              "query": [
                { "key": "granularidade", "value": "dia", "description": "hora | dia | semana | mes" },
                { "key": "dataInicio", "value": "2026-06-01T00:00:00Z", "disabled": true },
                { "key": "dataFim", "value": "2026-07-01T00:00:00Z", "disabled": true }
              ]
            }
          }
        },
