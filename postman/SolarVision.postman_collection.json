          "request": {
            "method": "POST",
            "header": [],
            "url": { "raw": "{{baseUrl}}/api/internal/grpc/alerts/email", "host": ["{{baseUrl}}"], "path": ["api", "internal", "grpc", "alerts", "email"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"to\": \"operacao@solarvision.com\",\n  \"template\": \"alerta-soiling\",\n  \"subject\": \"Alerta de sujeira na placa\",\n  \"panelId\": {{panelId}},\n  \"severity\": \"ALTA\",\n  \"soilingIndex\": 0.42\n}",
              "options": { "raw": { "language": "json" } }
            }
          }
        }
      ]
    }
