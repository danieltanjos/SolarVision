          }
        },
        {
          "name": "Intervalo de dados (range)",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/api/dashboard/range", "host": ["{{baseUrl}}"], "path": ["api", "dashboard", "range"] }
