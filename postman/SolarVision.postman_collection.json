          "name": "Criar grupo (salva groupId)",
          "request": {
            "method": "POST",
            "header": [],
            "url": { "raw": "{{baseUrl}}/api/groups", "host": ["{{baseUrl}}"], "path": ["api", "groups"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nome\": \"Usina Teste Postman\",\n  \"status\": \"ATIVO\"\n}",
              "options": { "raw": { "language": "json" } }
