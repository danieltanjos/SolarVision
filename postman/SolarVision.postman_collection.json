    },
    {
      "name": "GraphQL",
      "item": [
        {
          "name": "Query panels",
          "request": {
            "method": "POST",
            "header": [],
            "url": { "raw": "{{baseUrl}}/api/graphql", "host": ["{{baseUrl}}"], "path": ["api", "graphql"] },
            "body": {
              "mode": "graphql",
              "graphql": {
                "query": "query Panels($filter: PanelFilterInput) {\n  panels(filter: $filter) {\n    id\n    modelo\n    status\n    grupoId\n    grupoNome\n    criadoEm\n  }\n}",
                "variables": "{\n  \"filter\": { \"status\": \"ATIVA\" }\n}"
              }
            }
          }
        },
        {
          "name": "Query cleanings",
          "request": {
            "method": "POST",
            "header": [],
            "url": { "raw": "{{baseUrl}}/api/graphql", "host": ["{{baseUrl}}"], "path": ["api", "graphql"] },
            "body": {
              "mode": "graphql",
              "graphql": {
                "query": "query Cleanings($filter: CleaningFilterInput) {\n  cleanings(filter: $filter) {\n    id\n    placaId\n    placaModelo\n    dataLimpeza\n    observacao\n  }\n}",
                "variables": "{\n  \"filter\": {}\n}"
              }
            }
          }
        },
        {
          "name": "Mutation createPanel",
          "request": {
            "method": "POST",
            "header": [],
            "url": { "raw": "{{baseUrl}}/api/graphql", "host": ["{{baseUrl}}"], "path": ["api", "graphql"] },
            "body": {
              "mode": "graphql",
              "graphql": {
                "query": "mutation CreatePanel($input: CreatePanelInput!) {\n  createPanel(input: $input) {\n    id\n    modelo\n    status\n    grupoNome\n  }\n}",
                "variables": "{\n  \"input\": { \"grupoId\": \"{{groupId}}\", \"modelo\": \"Painel GraphQL\", \"status\": \"ATIVA\" }\n}"
              }
            }
          }
        }
      ]
    },
    {
      "name": "gRPC Bridge (REST -> gRPC)",
      "item": [
        {
          "name": "Checar placa",
          "request": {
            "method": "POST",
            "header": [],
