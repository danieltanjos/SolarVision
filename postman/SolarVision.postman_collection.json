          }
        },
        {
          "name": "Atualizar grupo",
          "request": {
            "method": "PUT",
            "header": [],
            "url": { "raw": "{{baseUrl}}/api/groups/{{groupId}}", "host": ["{{baseUrl}}"], "path": ["api", "groups", "{{groupId}}"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nome\": \"Usina Teste Postman (editada)\",\n  \"status\": \"MANUTENCAO\"\n}",
              "options": { "raw": { "language": "json" } }
            }
          }
        },
        {
          "name": "Placas do grupo",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/api/groups/{{groupId}}/panels", "host": ["{{baseUrl}}"], "path": ["api", "groups", "{{groupId}}", "panels"] }
          }
        },
        {
