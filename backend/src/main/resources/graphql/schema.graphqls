type Query {
  panels(filter: PanelFilterInput): [Panel!]!
  cleanings(filter: CleaningFilterInput): [Cleaning!]!
}

type Mutation {
  createPanel(input: CreatePanelInput!): Panel!
  createCleaning(input: CreateCleaningInput!): Cleaning!
}

input PanelFilterInput {
  grupoId: ID
  status: String
  modelo: String
}

input CleaningFilterInput {
  placaId: ID
  dataInicio: String
  dataFim: String
}

input CreatePanelInput {
  grupoId: ID!
  modelo: String!
  status: String
}

input CreateCleaningInput {
  placaId: ID!
  dataLimpeza: String!
  observacao: String
}

type Panel {
  id: ID!
  grupoId: ID!
  grupoNome: String!
  modelo: String!
  status: String!
  criadoEm: String!
}

type Cleaning {
  id: ID!
  placaId: ID!
  placaModelo: String!
  dataLimpeza: String!
  observacao: String
  criadoEm: String!
}
