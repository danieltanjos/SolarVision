type Query {
  dashboard: DashboardSummaryGraphql!
  groups: [Group!]!
  panels: [Panel!]!
  alerts: [Alert!]!
  cleanings: [Cleaning!]!
}

type DashboardSummaryGraphql {
  totalGroups: Int!
  totalPanels: Int!
  activeAlerts: Int!
}

type Group {
  id: ID!
  name: String!
  location: String!
  status: String!
  createdAt: String!
}

type Panel {
  id: ID!
  groupId: ID!
  serialNumber: String!
  model: String!
  status: String!
}

type Alert {
  id: ID!
  panelId: ID!
  type: String!
  severity: String!
  soilingIndex: Float
  createdAt: String!
  active: Boolean!
}

type Cleaning {
  id: ID!
  panelId: ID!
  performedAt: String!
  waterUsedLiters: Float!
  performedBy: String!
  notes: String
}
